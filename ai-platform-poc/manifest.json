{
  "manifest_version": 3,
  "name": "AI Platform PoC — JSON Demo",
  "version": "1.3.0",
  "description": "PoC local para extrair cookies usando o padrão Strategy.",
  "permissions": [
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://flow.google.com/*",
    "https://*.google.com/*",
    "https://vyral.com.br/*",
    "https://app.vyral.com.br/*",
    "https://leonardo.ai/*",
    "https://app.leonardo.ai/*",
    "https://*.pollo.ai/*",
    "https://magnific.com/*",
    "https://*.magnific.com/*",
    "https://digen.ai/*",
    "https://*.digen.ai/*"
  ],
  "background": {
    "scripts": [
      "gemini.js",
      "vyral.js",
      "leonardo.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://flow.google.com/*",
        "https://gemini.google.com/*",
        "https://app.vyral.com.br/*",
        "https://app.leonardo.ai/*",
        "https://*.pollo.ai/*",
        "https://magnific.com/*",
        "https://*.magnific.com/*",
        "https://digen.ai/*",
        "https://*.digen.ai/*"
      ],
      "js": [
        "theme.js",
        "json-builder.js",
        "export.js",
        "modal.js",
        "gemini.js",
        "vyral.js",
        "leonardo.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}