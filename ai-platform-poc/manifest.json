{
  "manifest_version": 3,
  "name": "AI Platform PoC — JSON Demo",
  "version": "1.0.0",
  "description": "PoC local para extrair cookies reais da sessão.",
  "permissions": [
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "theme.js",
        "json-builder.js",
        "export.js",
        "modal.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}