{
  "manifest_version": 3,
  "name": "AI Platform PoC \u2014 JSON Demo",
  "version": "1.1.0",
  "description": "PoC local para extrair cookies usando o padr\u00e3o Strategy.",
  "permissions": [
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://flow.google.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "scripts": [
      "gemini.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://flow.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "theme.js",
        "json-builder.js",
        "export.js",
        "modal.js",
        "gemini.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
